# Banco de dados Postgres — qualquer um serve (Supabase, Neon, etc.)
# Supabase: painel -> Connect -> Connection String -> Transaction pooler
#   ex.: postgresql://postgres.xxxx:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Neon via Vercel: Storage -> Create Database -> Neon -> Connect Project (automático)
POSTGRES_URL=

# Senha de administrador da aba "Central" (defina a sua!)
ADMIN_PIN=

# Segredo para assinar os tokens de login (qualquer texto aleatório longo)
AUTH_SECRET=

# (Opcional) Endereço da World Cup 2026 API — padrão: https://worldcup26.ir
# WC_API_BASE=
